# Environment Configuration for Infusion Pump ML System
ENV=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# MLflow Configuration
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=infusion_pump_ml

# Paths
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports

